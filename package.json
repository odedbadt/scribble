{
  "name": "scrib",
  "private": true,
  "version": "1.0.0",
  "description": "scribble app monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build:web": "npm -w @scrib/web run build",
    "test:web": "npm -w @scrib/web run test",
    "dev:web": "npm -w @scrib/web run dev",
    "dev:desktop": "npm -w @scrib/desktop run dev"
  }
}
