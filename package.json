{
  "name": "scrib",
  "type": "module",
  "version": "1.0.0",
  "description": "scribble app",
  "main": "electron/main.cjs",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "playwright test",
    "build": "webpack",
    "electron:dev": "electron .",
    "android:stage": "rm -rf dist-android && mkdir -p dist-android && npm run build && cp index.html dist-android/ && cp -R distro static dist-android/",
    "android:sync": "npm run android:stage && npx cap sync android",
    "android:dev": "npm run android:sync && npx cap open android",
    "android:debug": "npm run android:sync && (cd android && ./gradlew assembleDebug)",
    "android:release": "npm run android:sync && (cd android && ./gradlew assembleRelease)",
    "android:install": "npm run android:sync && (cd android && ./gradlew installDebug)"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@preact/signals": "^2.0.4",
    "@types/gapi.client.drive-v3": "^0.0.5",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "googleapis": "^144.0.0",
    "jest": "^29.7.0",
    "rxjs": "^7.8.1",
    "three": "^0.172.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@playwright/test": "1.55",
    "@types/gapi": "^0.0.47",
    "@types/gapi.auth2": "^0.0.61",
    "@types/gapi.client.drive": "^3.0.15",
    "@types/jsdom": "^27.0.0",
    "@types/three": "^0.172.0",
    "electron": "^42.3.0",
    "jsdom": "^27.0.0",
    "ts-loader": "^9.x.x",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  }
}
